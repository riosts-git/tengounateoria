---
import { slugify } from '../config';
const { post, i = 0 } = Astro.props;
---
<a class="card" href={post.href} data-cat={slugify(post.categoria)} data-tags={post.tags.map(slugify).join('|')} style={`--i:${i}`}>
  <div class="thumb">
    <div class="notebook"><div class="pages"></div><div class="cover"><div class="elastic"></div></div></div>
  </div>
  <div class="card-text">
    <h2 class="card-title">{post.title}</h2>
    {(post.subtitulo ?? post.description) && <p class="card-sub">{post.subtitulo ?? post.description}</p>}
  </div>
</a>
