---
import { slugify, u } from '../config';
const { post, i = 0 } = Astro.props;
const ar = post.tipo === 'libro' ? '3/4' : post.tipo === 'ensayo' ? (i % 2 ? '1/1.05' : '4/5') : i % 2 ? '4/5' : '1/1';
---
<a class="card" href={post.href} data-cat={slugify(post.categoria)} data-tags={post.tags.map(slugify).join('|')} data-tone={i % 3} style={`--i:${i}`}>
  <div class="thumb" style={`--ar:${ar}`}>
    {post.tipo === 'libro' && <div class="notebook"><div class="pages"></div><div class="cover"><div class="elastic"></div></div></div>}
    {post.tipo === 'ensayo' && <div class="paper"></div>}
    {post.tipo === 'foto' && (
      <div class="polaroid">
        {post.image ? <img src={u(post.image)} alt={post.alt ?? post.title} loading="lazy" /> : <i></i>}
      </div>
    )}
  </div>
  <span class="card-title">{post.title}</span>
</a>
