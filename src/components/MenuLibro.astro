---
// Menú lateral derecho de un cuaderno: sus partes y, dentro de cada una, sus ensayos.
// Se usa en la página de cada cuaderno y en cada ensayo.
import { slugify, tituloPlano, u, libroDe } from '../config';
import { partesDe, type Post } from '../lib/posts';

interface Props { cat: string; posts: Post[]; aqui?: string; abierto?: boolean }
// abierto: todas las partes desplegadas (en los cuadernos que se leen de corrido)
const { cat, posts, aqui, abierto } = Astro.props;
const libro = libroDe(cat);
const href = libro ? u(`cuadernos/${libro.slug}/`) : u('#ideas-sueltas');
const conPartes = posts.some((p) => p.parte);
---
<aside class="menu-libro" data-c={slugify(cat)} aria-label={`Ensayos de ${cat}`}>
  <a class="menu-libro-t" href={href}>{cat}</a>
  <p class="menu-libro-n">{posts.length} ensayos</p>
  {conPartes ? (
    partesDe(posts).map((g) => (
      <details class="nav-parte" open={abierto || !aqui || g.posts.some((p) => p.href === aqui)}>
        <summary>
          <svg class="flecha" viewBox="0 0 10 10" width="8" height="8" aria-hidden="true"><path d="M3 1.5 6.5 5 3 8.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {g.parte}
        </summary>
        <ol class="nav-ensayos">
          {g.posts.map((p) => <li><a href={p.href} aria-current={p.href === aqui ? 'page' : undefined}>{tituloPlano(p.title)}</a></li>)}
        </ol>
      </details>
    ))
  ) : (
    <ol class="nav-ensayos nav-sueltos">
      {posts.map((p) => <li><a href={p.href} aria-current={p.href === aqui ? 'page' : undefined}>{tituloPlano(p.title)}</a></li>)}
    </ol>
  )}
</aside>
