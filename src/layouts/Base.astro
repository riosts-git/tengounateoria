---
import '../styles/global.css';
import { ENSAYOS, etiqueta } from '../data/ensayos';
import { getCollection } from 'astro:content';

interface Props { title?: string; acc?: string; volver?: boolean; actual?: string }
const { title, acc, volver = false, actual = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caps = await getCollection('capitulos');
const disponibles = (id: string) => caps.filter((c) => c.data.ensayo === id).map((c) => c.data.orden);
const fullTitle = title ? `${title} · Tengo una teoría` : 'Tengo una teoría';
---
<!doctype html>
<html lang="es" style={acc ? `--acc:${acc}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" />
  </head>
  <body>
    <div class="top">
      <a class="brand" href={`${base}/`}>TENGO UNA TEORÍA.</a>
      <nav>
        {volver && <a class="pill ghost" href={`${base}/`}>Ensayos</a>}
        <button class="pill" id="ib" aria-expanded="false">Índice</button>
      </nav>
    </div>
    <div id="prog"></div>
    <main><slot /></main>

    <nav id="ix" aria-label="Índice">
      {ENSAYOS.map((e) => {
        const hay = disponibles(e.id).length > 0;
        return (
          <div class={`xg${e.id === actual ? ' open' : ''}`}>
            <div class="xh">
              {hay ? (
                <>
                  <a class="xs" href={`${base}/${e.id}/`}>{etiqueta(e)}</a>
                  <button class="tg" aria-label="Capítulos"></button>
                </>
              ) : (
                <span class="xs off">{etiqueta(e)} · por escribir</span>
              )}
            </div>
            <div class="xk">
              {e.capitulos.map((t, i) =>
                disponibles(e.id).includes(i + 1) ? <a href={`${base}/${e.id}/#cap-${i}`}>{t}</a> : <span class="soft">{t}</span>
              )}
            </div>
          </div>
        );
      })}
    </nav>

    <script>
      const ix = document.getElementById('ix');
      const ib = document.getElementById('ib');
      document.addEventListener('click', (ev) => {
        const t = ev.target as HTMLElement;
        if (t.closest('#ib')) {
          const on = ix!.classList.toggle('on');
          ib!.setAttribute('aria-expanded', String(on));
          return;
        }
        const tg = t.closest('.tg');
        if (tg) { tg.closest('.xg')!.classList.toggle('open'); return; }
        if (!t.closest('#ix')) ix!.classList.remove('on');
        else if (t.closest('.xk a,.xs')) ix!.classList.remove('on');
      });
    </script>
  </body>
</html>
