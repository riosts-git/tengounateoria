---
import '../styles/global.css';
import { SITE, CATS, slugify, u } from '../config';
import { getPosts } from '../lib/posts';

const { title = SITE.title, description = SITE.description, image, type = 'website', jsonLd } = Astro.props;
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.tags))].sort();
const full = title === SITE.title ? title : `${title} · ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const img = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
const navs = [['Inicio', u('')], ['Ensayos', u('ensayos/')], ['Libros', u('libros/')], ['Fotos', u('fotos/')]];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href={u('rss.xml')} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:locale" content="es_ES" />
  {img && <meta property="og:image" content={img} />}
  <meta name="twitter:card" content={img ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  {img && <meta name="twitter:image" content={img} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;700&family=Courier+Prime:wght@400;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <aside class="sidebar">
    <a href={u('')} class="brand"><h1>{SITE.title}</h1></a>
    <span class="tagline">{SITE.tagline}</span>
    <nav class="filters" aria-label="Secciones">
      {navs.map(([label, href]) => (
        <a class:list={['chip', { active: href === u('') ? path === href : path.startsWith(href) }]} href={href}>{label}</a>
      ))}
    </nav>
    <hr class="divider" />
    <nav class="filters" aria-label="Temas">
      <a class="chip" data-cat="todas" href={u('')}>todas</a>
      {CATS.map((c) => <a class="chip" data-cat={slugify(c)} href={u(`?cat=${slugify(c)}`)}>{c}</a>)}
    </nav>
    <hr class="divider" />
    <div class="tags-row">
      {tags.map((t) => <a class="tag" data-tag={slugify(t)} href={u(`?tag=${slugify(t)}`)}>{t}</a>)}
    </div>
  </aside>
  <main><slot /></main>
  <footer>
    <div class="footer-inner">
      <h4>Gracias por leer</h4>
      <p>Aquí voy dejando lo que pienso, a medida que lo pienso. <a href={u('rss.xml')}>RSS</a></p>
    </div>
  </footer>
</body>
</html>
