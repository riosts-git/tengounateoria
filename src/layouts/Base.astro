---
import '../styles/global.css';
import { SITE, CATS, slugify, u } from '../config';
import { getPosts } from '../lib/posts';

const { title = SITE.title, description = SITE.description, type = 'website', jsonLd } = Astro.props;
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.tags))].sort();
const full = title === SITE.title ? title : `${title} · ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href={u('rss.xml')} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;700&family=Courier+Prime:wght@400;700&family=Inter:wght@400;500;600&family=Newsreader:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <aside class="sidebar">
    <a href={u('')} class="brand"><h1>{SITE.title}</h1></a>
    <span class="tagline">{SITE.tagline}</span>
    <nav class="filters" aria-label="Temas">
      {CATS.map((c) => <a class="chip" data-c={slugify(c)} href={`${u('')}#${slugify(c)}`}>{c}</a>)}
    </nav>
    <hr class="divider" />
    <div class="tags-row">
      {tags.map((t) => <a class="tag" data-tag={slugify(t)} href={u(`?tag=${slugify(t)}`)}>{t}</a>)}
    </div>
  </aside>
  <main><slot /></main>
  <footer>
    <div class="footer-inner">
      <h4>Gracias por leer</h4>
      <p>Aquí voy dejando lo que pienso, a medida que lo pienso. <a href={u('rss.xml')}>RSS</a></p>
      <a class="substack" href={SITE.substack} target="_blank" rel="noopener me" aria-label="Tengo una Teoría en Substack" title="Substack">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
      </a>
    </div>
  </footer>
</body>
</html>
