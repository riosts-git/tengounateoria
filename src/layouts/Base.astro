---
import '../styles/global.css';
import { SITE, LIBROS, u } from '../config';
import { entradaDe } from '../lib/posts';

const { title = SITE.title, description = SITE.description, type = 'website', jsonLd, libro } = Astro.props;
const aqui = Astro.url.pathname.replace(/\/?$/, '/');
const full = title === SITE.title ? title : `${title} · ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// El menú superior marca la sección actual: «Sobre mí» o el cuaderno del ensayo que se está leyendo.
const activo = (href: string, cat?: string) => aqui === href || (!!cat && libro === cat);
// Cada cuaderno entra por su índice, o por su primer ensayo si se lee de corrido
const entradas = await Promise.all(LIBROS.map(async (l) => ({ ...l, href: await entradaDe(l) })));
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href={u('rss.xml')} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Fira+Mono&family=Caveat:wght@500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <div class="top-in">
      <a href={u('')} class="brand">{SITE.title}</a>
      <nav class="top-nav" aria-label="Secciones">
        <a href={u('sobre-mi/')} aria-current={activo(u('sobre-mi/')) ? 'page' : undefined}>Sobre mí</a>
        {entradas.map((l) => <a href={l.href} aria-current={activo(u(`cuadernos/${l.slug}/`), l.cat) ? 'page' : undefined}>{l.corto}</a>)}
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer>
    <div class="footer-inner">
      <h4>Gracias por leer</h4>
      <p>Aquí voy dejando lo que pienso, a medida que lo pienso. <a href={u('rss.xml')}>RSS</a></p>
      <a class="substack" href={SITE.substack} target="_blank" rel="noopener me" aria-label="Tengo una Teoría en Substack" title="Substack">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
      </a>
    </div>
  </footer>
</body>
</html>
