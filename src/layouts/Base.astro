---
import '../styles/global.css';
import { SITE, slugify, tituloPlano, u } from '../config';
import { getPosts, getPostsByCat } from '../lib/posts';

const { title = SITE.title, description = SITE.description, type = 'website', jsonLd } = Astro.props;
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.tags))].sort((a, b) => a.localeCompare(b, 'es'));
const cuantos = (t: string) => posts.filter((p) => p.tags.includes(t)).length;
const libros = await getPostsByCat();
const aqui = Astro.url.pathname.replace(/\/?$/, '/');
// Agrupa los ensayos de un cuaderno por parte, respetando el orden.
type P = (typeof posts)[number];
const partesDe = (ps: P[]) => ps.reduce<{ parte: string; posts: P[] }[]>((acc, p) => {
  const nombre = p.parte ?? 'Ensayos';
  const ultimo = acc[acc.length - 1];
  if (ultimo && ultimo.parte === nombre) ultimo.posts.push(p); else acc.push({ parte: nombre, posts: [p] });
  return acc;
}, []);
const full = title === SITE.title ? title : `${title} · ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href={u('rss.xml')} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;1,14..32,400&display=swap" rel="stylesheet" />
</head>
<body>
  <aside class="sidebar">
    <a href={u('')} class="brand"><h1>{SITE.title}</h1></a>
    <span class="tagline">{SITE.tagline}</span>
    <nav class="filters" aria-label="Cuadernos">
      {libros.map((c) => (
        <details class="libro" data-c={slugify(c.name)} open={c.posts.some((p) => p.href === aqui)}>
          <summary class="chip" data-c={slugify(c.name)} data-href={`${u('')}#${slugify(c.name)}`}>
            <svg class="flecha" viewBox="0 0 10 10" width="9" height="9" aria-hidden="true"><path d="M3 1.5 6.5 5 3 8.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {c.name}
          </summary>
          {!c.posts.some((p) => p.parte) && (
            <ol class="nav-ensayos nav-sueltos">
              {c.posts.map((p) => <li><a href={p.href} aria-current={p.href === aqui ? 'page' : undefined}>{tituloPlano(p.title)}</a></li>)}
            </ol>
          )}
          <div class="nav-partes" hidden={!c.posts.some((p) => p.parte)}>
            {partesDe(c.posts).map((g) => (
              <details class="nav-parte" open={g.posts.some((p) => p.href === aqui)}>
                <summary>
                  <svg class="flecha" viewBox="0 0 10 10" width="8" height="8" aria-hidden="true"><path d="M3 1.5 6.5 5 3 8.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {g.parte}
                </summary>
                <ol class="nav-ensayos">
                  {g.posts.map((p) => <li><a href={p.href} aria-current={p.href === aqui ? 'page' : undefined}>{tituloPlano(p.title)}</a></li>)}
                </ol>
              </details>
            ))}
          </div>
        </details>
      ))}
    </nav>
    <hr class="divider" />
    <div class="tags-row">
      {tags.map((t) => <a class="tag" data-tag={slugify(t)} href={u(`?tag=${slugify(t)}`)}>{t}<span class="tag-n">{cuantos(t)}</span></a>)}
    </div>
  </aside>
  <main><slot /></main>
  <script>
    // En el celular el menú es una fila de botones: tocar un cuaderno lleva a su moleskine en vez de desplegarlo.
    document.querySelectorAll<HTMLElement>('.libro > summary').forEach((s) => s.addEventListener('click', (e) => {
      if (matchMedia('(max-width: 860px)').matches) { e.preventDefault(); location.href = s.dataset.href!; }
    }));
  </script>
  <footer>
    <div class="footer-inner">
      <h4>Gracias por leer</h4>
      <p>Aquí voy dejando lo que pienso, a medida que lo pienso. <a href={u('rss.xml')}>RSS</a></p>
      <a class="substack" href={SITE.substack} target="_blank" rel="noopener me" aria-label="Tengo una Teoría en Substack" title="Substack">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
      </a>
    </div>
  </footer>
</body>
</html>
