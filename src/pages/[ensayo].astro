---
import Base from '../layouts/Base.astro';
import { ENSAYOS, ROMANO, etiqueta, slug } from '../data/ensayos';
import { getCollection } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

export async function getStaticPaths() {
  const caps = await getCollection('capitulos');
  return ENSAYOS.filter((e) => caps.some((c) => c.data.ensayo === e.id)).map((e) => ({ params: { ensayo: e.id }, props: { id: e.id } }));
}

const { id } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ensayo = ENSAYOS.find((e) => e.id === id)!;
const siguiente = ENSAYOS.find((e) => e.n === ensayo.n + 1);
const publicados = await getCollection('capitulos');
const siguientePublicado = !!siguiente && publicados.some((c) => c.data.ensayo === siguiente.id);

// Dibujos: src/assets/svg/<ensayo>/<capitulo>_<subtitulo>.svg (se incrustan, como en el HTML de trabajo)
const svgs = import.meta.glob('../assets/svg/**/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const svgPorNombre: Record<string, string> = Object.fromEntries(
  Object.entries(svgs).map(([ruta, s]) => [ruta.split('/').pop()!.replace('.svg', ''), s])
);

const proc = await createMarkdownProcessor();

// Bibliografía y notas: src/content/bibliografia/<ensayo>.md (no es un capítulo: se abre con un botón al final)
const bibs = import.meta.glob('../content/bibliografia/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const bibRaw = Object.entries(bibs).find(([r]) => r.endsWith('/' + id + '.md'))?.[1] ?? '';
const bibHtml = bibRaw ? (await proc.render(bibRaw.replace(/^---[\s\S]*?---\s*/, ''))).code : '';
const entradas = (await getCollection('capitulos')).filter((c) => c.data.ensayo === id).sort((a, b) => a.data.orden - b.data.orden);

const notas: string[] = [];
const capitulos = [];
for (const entrada of entradas) {
  let cuerpo = entrada.body ?? '';
  cuerpo = cuerpo.replace(/^\[\^(\d+)\]:\s*(.*)$/gm, (_m, n, t) => { notas[Number(n) - 1] = t; return ''; });
  cuerpo = cuerpo.replace(/\[\^(\d+)\]/g, '<sup>$1</sup>');
  const partes = cuerpo.split(/^## /m);
  const escenas = [];
  for (let i = 0; i < partes.length; i++) {
    const parte = partes[i];
    if (i === 0 && !parte.trim()) continue;
    let titulo = '';
    let md = parte;
    if (i > 0) {
      const salto = parte.indexOf('\n');
      titulo = parte.slice(0, salto).trim();
      md = parte.slice(salto + 1);
    }
    const html = (titulo ? `<h4>${titulo}</h4>` : '') + (await proc.render(md)).code;
    const clave = `${slug(entrada.data.title)}_${titulo ? slug(titulo) : 'inicio'}`;
    escenas.push({ html, svg: svgPorNombre[clave] ?? '' });
  }
  capitulos.push({ titulo: entrada.data.title, escenas, prologo: entrada.data.prologo === true, epilogo: entrada.data.epilogo === true });
}
// Un capítulo con «prologo: true» es el prólogo: no se numera
const off = capitulos[0]?.prologo ? 0 : 1;
const etq = (c: { prologo: boolean; epilogo?: boolean }, i: number) => (c.prologo ? 'prólogo' : c.epilogo ? 'epílogo' : `capítulo ${i + off}`);
const n = capitulos.filter((c) => !c.prologo && !c.epilogo).length;
---
<Base title={etiqueta(ensayo)} acc={ensayo.acc} volver actual={ensayo.id}>
  <div class="reader" style={`--tint:${ensayo.tint}`}>
    <aside class="stage" aria-label="Ilustraciones">
      <div class="card">
        <div class="frames">
          <figure class="fig cv portada on" data-k="p">
            <div><span class="nota hand">Apuntes {ROMANO[ensayo.n]}</span><b>{ensayo.title}</b><span class="nota hand sub">{n} {n === 1 ? 'capítulo' : 'capítulos'}</span></div>
          </figure>
          {capitulos.map((c, ci) => (
            <>
              {ci > 0 && (<figure class="fig cv" data-k={`c${ci}`}><div><span class="nota hand">{etq(c, ci)}</span><b>{c.titulo}</b></div></figure>)}
              {c.escenas.map((s, si) => <figure class="fig" data-k={`f${ci}-${si}`} set:html={s.svg} />)}
            </>
          ))}
        </div>
        <div class="legend">
          <p class="cap" id="cap" aria-live="polite"></p>
          <div class="ticks" style={`--n:${capitulos.length}`}>
            {capitulos.map((c, i) => <button data-go={i} aria-label={`${etq(c, i)}: ${c.titulo}`} title={c.prologo || c.epilogo ? c.titulo : `${i + off}. ${c.titulo}`}></button>)}
          </div>
        </div>
      </div>
    </aside>

    <article class="text">

      {capitulos.map((c, ci) => (
        <>
          <section class="scene head" data-c={ci} data-keys={ci === 0 ? 'p' : `c${ci}`} style="--n:1">
            <header class="ch" id={`cap-${ci}`}>
              <span class="nota hand">{etq(c, ci)}</span>
              <h2>{c.titulo}</h2>
            </header>
          </section>
          {c.escenas.map((s, si) => (
            <section class="scene" data-c={ci} data-keys={`f${ci}-${si}`} style="--n:1" set:html={s.html} />
          ))}
        </>
      ))}

      <div class="fin">
        {(notas.length > 0 || bibHtml) && <button type="button" class="vermas" id="verbib">Ver Bibliografía y notas</button>}
        {siguiente && (siguientePublicado
          ? <a class="continua" href={`${base}/${siguiente.id}/`}><span>Continúa en el apunte</span><b>{siguiente.title} <i aria-hidden="true">→</i></b></a>
          : <p class="continua off"><span>Continúa en el apunte</span><b>{siguiente.title} <i aria-hidden="true">→</i></b></p>)}
        <a class="volver" href={`${base}/`}>Volver a todos los ensayos</a>
      </div>

      <dialog id="biblio" aria-label="Bibliografía y notas">
        <button type="button" class="cerrar" data-cerrar aria-label="Cerrar">×</button>
        <h3>Bibliografía y notas</h3>
        {notas.length > 0 && (<><h4>Notas</h4><ol class="lista-notas">{notas.map((t) => <li set:html={t} />)}</ol></>)}
        <div class="bib" set:html={bibHtml} />
      </dialog>    </article>
  </div>

  <script>
    const figs = [...document.querySelectorAll<HTMLElement>('.fig')];
    const ticks = [...document.querySelectorAll<HTMLElement>('.ticks button')];
    const capEl = document.getElementById('cap')!;
    const scenes = [...document.querySelectorAll<HTMLElement>('.scene')];
    const prog = document.getElementById('prog')!;
    let actual = '';

    const mostrar = (k: string, c: number) => {
      if (k === actual) return;
      actual = k;
      figs.forEach((f) => f.classList.toggle('on', f.dataset.k === k));
      capEl.textContent = ticks[c]?.title ?? '';
      ticks.forEach((t, i) => { t.classList.toggle('cur', i === c); t.classList.toggle('pass', i < c); });
    };
    const tick = () => {
      if (scrollY < innerHeight * 0.35) { mostrar('p', 0); prog.style.transform = 'scaleX(0)'; return; }
      const y = innerHeight * 0.5;
      for (const s of scenes) {
        const r = s.getBoundingClientRect();
        if (r.top <= y && r.bottom > y) { mostrar(s.dataset.keys!.split(',')[0], Number(s.dataset.c)); break; }
      }
      const h = document.documentElement;
      prog.style.transform = `scaleX(${scrollY / Math.max(1, h.scrollHeight - innerHeight)})`;
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(tick); }, { passive: true });
    ticks.forEach((t) => t.addEventListener('click', () => document.getElementById('cap-' + t.dataset.go)?.scrollIntoView({ behavior: 'smooth', block: 'start' })));
    tick();
    const dlg = document.getElementById('biblio') as HTMLDialogElement | null;
    document.getElementById('verbib')?.addEventListener('click', () => dlg?.showModal());
    dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg?.querySelector('[data-cerrar]')?.addEventListener('click', () => dlg.close());
  </script>
</Base>
