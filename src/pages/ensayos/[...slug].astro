---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/ensayo.css';
import { SITE, u, slugify } from '../../config';
import { byOrden } from '../../lib/posts';

export async function getStaticPaths() {
  const entries = await getCollection('ensayos', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: entries } }));
}

const { entry, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const fmt = (x: Date) => x.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const actualizado = fmt(d.actualizado ?? d.date);
const minutos = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).filter(Boolean).length / 200));

// Anterior / siguiente dentro de la misma categoría, en orden de lectura
const serie = all.filter((s) => s.data.categoria === d.categoria).sort((a, b) => byOrden(a.data, b.data));
const at = serie.findIndex((s) => s.id === entry.id);
const prev = at > 0 ? serie[at - 1] : undefined;
const next = at >= 0 ? serie[at + 1] : undefined;

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  ...(d.actualizado && { dateModified: d.actualizado.toISOString() }),
  author: { '@type': 'Person', name: SITE.author },
  inLanguage: 'es',
  mainEntityOfPage: url,
};
---
<Base title={d.title} description={d.description} type="article" jsonLd={jsonLd}>
  <div class="progress" aria-hidden="true"></div>
  <article class="post ensayo" data-cat={slugify(d.categoria)}>
    <header class="head">
      <p class="post-cat"><a href={`${u('')}#${slugify(d.categoria)}`}>{d.categoria}</a></p>
      <h1>{d.title}</h1>
      {d.subtitulo && <p class="subtitulo">{d.subtitulo}</p>}
      <ul class="tiny">
        <li>{minutos} min de lectura</li>
        {d.version && <li>{d.version}</li>}
        <li>Última actualización: {actualizado}</li>
      </ul>
    </header>
    <div class="prose"><Content /></div>
    {d.tags.length > 0 && (
      <div class="post-tags">{d.tags.map((t) => <a class="tag" href={u(`?tag=${slugify(t)}`)}>{t}</a>)}</div>
    )}
    {(prev || next) && (
      <nav class="pn" aria-label="Otros ensayos">
        {prev && <a class="prev" href={u(`ensayos/${prev.id}/`)}><small>Anterior</small><strong>{prev.data.title}</strong></a>}
        {next && <a class="next" href={u(`ensayos/${next.id}/`)}><small>Siguiente</small><strong>{next.data.title}</strong></a>}
      </nav>
    )}
  </article>
</Base>
