---
import Base from '../layouts/Base.astro';
import { getPostsByCat, bajada, entradaDe } from '../lib/posts';
import { SITE, LIBROS, HOJAS, slugify, tituloPlano, u } from '../config';
import ArbolLineas from '../components/ArbolLineas.astro';
const cats = await getPostsByCat();
const libros = await Promise.all(LIBROS.map(async (l) => ({ ...l, href: await entradaDe(l), posts: cats.find((c) => c.name === l.cat)?.posts ?? [] })));
const obs = cats.find((c) => c.name === 'Observaciones')?.posts ?? [];
// Las micro observaciones de una misma hoja se muestran como una sola ficha, en el lugar de la primera
const ideas = obs.flatMap((p, i) => {
  if (!p.hoja || !HOJAS[p.hoja]) return [{ title: p.title, tags: p.tags, href: p.href, bajada: bajada(p) }];
  if (obs.findIndex((q) => q.hoja === p.hoja) !== i) return [];
  const de = obs.filter((q) => q.hoja === p.hoja);
  return [{ title: HOJAS[p.hoja].titulo, tags: [...new Set(de.flatMap((q) => q.tags))], href: u(`hojas/${p.hoja}/`), bajada: `${de.length === 1 ? '1 nota' : `${de.length} notas`} · ${HOJAS[p.hoja].bajada}` }];
});
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.title, description: SITE.description, inLanguage: 'es' };
const cuantos = (n: number) => (n === 1 ? '1 apunte' : `${n} apuntes`);
// La pregunta que responde cada cuaderno (se muestra bajo la moleskine)
const PREGUNTA: Record<string, string> = {
  'Tengo una teoría': 'Cómo procesamos cada experiencia: de la intuición a las emociones, y de las emociones al árbol.',
};
---
<Base jsonLd={jsonLd}>
  <div class="home">
    <!-- Portada del estilo «libro»: el libro como objeto, con dos citas a los costados (oculta en el estilo normal) -->
    <section class="portada-libro">
      <p class="cita">«Un mapa del mundo no te lleva a ningún lado. Pero te dice dónde estás.»<span>el modelo</span></p>
      <a class="objeto" href={libros[0].href}><small>Un ensayo</small><strong>Tengo<br />una teoría</strong><ArbolLineas variante="hilos" /></a>
      <p class="cita">«No pretendo decir qué pieza mover, sino mostrar la forma del tablero.»<span>sobre este libro</span></p>
      <p class="leer"><a href={libros[0].href}>Empezar a leer</a> · <a href="#observaciones">Leer una observación</a></p>
    </section>
    <!-- Portada: a la izquierda el texto, a la derecha la moleskine grande del libro -->
    <header class="portada">
      <div class="portada-txt">
        <h1>Tengo una teoría.</h1>
        <p>Tantos años investigué y enloquecí a mis amigos con mis teorías sobre la intuición, las emociones y los arquetipos, que decidí darles un respiro y ponerlas todas aquí.</p>
        <div class="botones">
          <a class="boton principal" href={libros[0].href}>Empezar a leer</a>
          <a class="boton" href="#observaciones">Leer una observación</a>
        </div>
      </div>
      {libros.map((l) => (
        <a class="libro-card libro-grande" href={l.href} data-c={slugify(l.cat)}>
          <div class="cat-thumb" aria-hidden="true">
            <div class="notebook"><div class="pages"></div><div class="cover"><div class="elastic"></div></div></div>
          </div>
          <span class="libro-pregunta">{PREGUNTA[l.cat]}</span>
          <p>{cuantos(l.posts.length).replace('apunte', 'capítulo')}</p>
        </a>
      ))}
    </header>

    <!-- Debajo: el árbol en un tercio (queda fijo al bajar) y las observaciones en los otros dos, como fichas horizontales -->
    <section class="abajo">
      <aside class="abajo-arbol">
        <svg class="arbolito" id="arbolito" viewBox="0 0 300 480" role="img" aria-label="El Árbol de Arquetipos: diez círculos y una X unidos por veintidós líneas, en tres columnas"></svg>
        <p class="arbol-pie">El Árbol de Arquetipos</p>
      </aside>
      {ideas.length > 0 && (
        <div class="ideas" id="observaciones">
          <h2 id="ideas-t">Observaciones</h2>
          <p class="ideas-bajada">Ideas sueltas que ponen a prueba el modelo con autores y ejemplos. Se pueden leer en cualquier orden.</p>
          <ul class="fichas" aria-labelledby="ideas-t">
            {ideas.map((p) => (
              <li><a class="ficha" href={p.href}>
                <span class="ficha-txt">
                  {p.tags.length > 0 && <span class="idea-tags">{p.tags.map((tag) => <span>{tag}</span>)}</span>}
                  <h3>{tituloPlano(p.title)}</h3>
                  <span class="ficha-bajada">{p.bajada}</span>
                </span>
                <span class="ficha-flecha" aria-hidden="true">→</span>
              </a></li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <section class="como-leer" aria-labelledby="como-t">
      <h2 id="como-t">Cómo leer este sitio</h2>
      <ol>
        <li>Si te interesa la idea general, empezá por <a href={libros[0].href}>el libro</a>.</li>
        <li>Si preferís ver el modelo funcionando, leé una observación y seguí sus enlaces.</li>
        <li>Cada observación se entiende sola: podés entrar por la que más te llame.</li>
      </ol>
    </section>

  </div>

<script is:inline>
(function(){
var N=[[150,30],[240,100],[60,100],[240,200],[60,200],[150,250],[240,330],[60,330],[150,380],[150,450],[150,150]];
var E=[[0,1],[0,2],[0,5],[1,2],[1,5],[1,3],[2,5],[2,4],[3,4],[3,5],[3,6],[4,5],[4,7],[5,6],[5,7],[5,8],[6,7],[6,8],[6,9],[7,8],[7,9],[8,9]];
var NS="http://www.w3.org/2000/svg",svg=document.getElementById("arbolito");if(!svg)return;
function el(t,a,p){var e=document.createElementNS(NS,t);for(var k in a)e.setAttribute(k,a[k]);(p||svg).appendChild(e);return e}
var L=E.map(function(e){var a=N[e[0]],b=N[e[1]];return el("line",{"class":"p",x1:a[0],y1:a[1],x2:b[0],y2:b[1],pathLength:1,style:"--d:"+(0.2+Math.min(e[0],e[1])*0.18).toFixed(2)+"s"})});
var G=N.map(function(n,i){var g=el("g",{"class":i===10?"n d":"n",tabindex:0,style:"--d:"+(0.4+i*0.2).toFixed(2)+"s"});
var a=el("g",{"class":"a"},g),m=el("g",{"class":"in"},a);el("circle",{"class":"halo",cx:n[0],cy:n[1],r:22},m);el("circle",{"class":"core",cx:n[0],cy:n[1],r:12},m);return g});
var ALL=false;
function on(i){if(ALL)return;svg.classList.add("hl");G.forEach(function(g,j){g.classList.toggle("me",j===i);g.classList.remove("on")});G[i].classList.add("on");
E.forEach(function(e,k){var hit=e[0]===i||e[1]===i;L[k].classList.toggle("on",hit);if(hit){G[e[0]].classList.add("on");G[e[1]].classList.add("on")}})}
function off(){svg.classList.remove("hl");G.forEach(function(g){g.classList.remove("on","me")});L.forEach(function(l){l.classList.remove("on")})}
var T;function setAll(){off();ALL=true;svg.classList.add("all");clearTimeout(T);T=setTimeout(function(){ALL=false;svg.classList.remove("all")},2200)}
G[10].setAttribute("role","button");G[10].setAttribute("aria-label","Encender todo el árbol");
G[10].addEventListener("click",setAll);
G[10].addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();setAll()}});
G.slice(0,10).forEach(function(g,i){g.addEventListener("pointerenter",function(){on(i)});g.addEventListener("pointerdown",function(){on(i)});g.addEventListener("pointerleave",off);g.addEventListener("focus",function(){on(i)});g.addEventListener("blur",off)});
})();
</script>
</Base>
