---
import Base from '../layouts/Base.astro';
import { getPostsByCat, bajada, entradaDe } from '../lib/posts';
import { SITE, LIBROS, slugify, tituloPlano, u } from '../config';
const cats = await getPostsByCat();
const libros = await Promise.all(LIBROS.map(async (l) => ({ ...l, href: await entradaDe(l), posts: cats.find((c) => c.name === l.cat)?.posts ?? [] })));
const ideas = cats.find((c) => c.name === 'Ideas sueltas')?.posts ?? [];
// Cada idea suelta es una ficha cuadrada: el tamaño, la inclinación y el papel varían en ciclos distintos para que no se repitan.
const TAM = [{ s: 236, t: 23 }, { s: 204, t: 20 }, { s: 268, t: 26 }, { s: 218, t: 21 }, { s: 250, t: 24 }];
const GIRO = [-2.4, 1.7, -0.9, 2.5, -1.7, 1.1, -2.8, 0.6];
const PAPEL = ['blanco', 'gris', 'crudo', 'claro', 'oscuro', 'piedra'];
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.title, description: SITE.description, inLanguage: 'es' };
const cuantos = (n: number) => (n === 1 ? '1 ensayo' : `${n} ensayos`);
---
<Base jsonLd={jsonLd}>
  <h1 class="sr-only">{SITE.title}</h1>
  <div class="home">
    <section class="libros" aria-label="Cuadernos">
      {libros.map((l) => (
        <a class="libro-card" href={l.href} data-c={slugify(l.cat)}>
          <div class="cat-thumb" aria-hidden="true">
            <div class="notebook"><div class="pages"></div><div class="cover"><div class="elastic"></div></div></div>
          </div>
          <h2>{l.cat}</h2>
          <p>{cuantos(l.posts.length)}</p>
        </a>
      ))}
    </section>

    {ideas.length > 0 && (
      <section class="ideas" id="ideas-sueltas" aria-labelledby="ideas-t">
        <h2 id="ideas-t">Ideas sueltas</h2>
        <div class="muro">
          {ideas.map((p, i) => {
            const { s, t } = TAM[i % TAM.length];
            return (
              <a class={`idea papel-${PAPEL[i % PAPEL.length]}`} href={p.href}
                 style={`--s:${s}px;--t:${t}px;--r:${GIRO[i % GIRO.length]}deg`}>
                {p.tags.length > 0 && <span class="idea-tags">{p.tags.map((tag) => <span>{tag}</span>)}</span>}
                <h3>{tituloPlano(p.title)}</h3>
                <p>{bajada(p)}</p>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</Base>
