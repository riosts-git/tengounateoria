---
import Base from '../layouts/Base.astro';
import { ENSAYOS, ROMANO } from '../data/ensayos';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caps = await getCollection('capitulos');
const hayCapitulo = (id: string, orden: number) => caps.some((c) => c.data.ensayo === id && c.data.orden === orden);
---
<Base>
  <div class="home">
    <section class="hero">
      <h1>
        Tengo<br />una <span>teoría<svg viewBox="0 0 300 20" preserveAspectRatio="none"><path d="M3 12 C 40 2, 70 18, 110 9 S 190 3, 230 11 S 280 14, 297 6" fill="none" stroke="#F2FDBF" stroke-width="8" stroke-linecap="round" /></svg></span>
      </h1>
      <div>
        <p>Durante años enloquecí a mis amigos con mi obsesión por las palabras y su significado. Así que se me ocurrió darles un respiro y juntar todas aquí.</p>
        <span class="nota hand">Está pensado para leerse en orden ↓</span>
      </div>
    </section>
    <section class="shelf" aria-label="Ensayos">
      {ENSAYOS.map((e) => {
        const hay = e.capitulos.length > 0 && caps.some((c) => c.data.ensayo === e.id);
        return (
          <div class={`book${hay ? '' : ' draft'}`} style={`--tint:${e.tint}`}>
            <div>
              <span class="nota hand">Ensayo {ROMANO[e.n]}</span>
              <h2>{hay ? <a href={`${base}/${e.id}/`}>{e.title}</a> : e.title}</h2>
            </div>
            {hay ? (
              <ol>
                {e.capitulos.map((t, i) => (
                  <li>{hayCapitulo(e.id, i + 1) ? <a href={`${base}/${e.id}/#cap-${i}`}>{t}</a> : <span class="soft">{t}</span>}</li>
                ))}
              </ol>
            ) : (
              <p class="hand meta">por escribir</p>
            )}
          </div>
        );
      })}
    </section>
    <footer class="foot">
      © Tengo una teoría
    </footer>
  </div>
</Base>
